---
import Page from '../../../src/components/Page.astro';
import { site } from '../../eurth.config.mjs';
---

<Page site={site} title="Page not found" description="This page doesn't exist. The components, the tokens and the handbook do." noindex>
  <div class="eu-prose">
    <h1>Page not found</h1>
    <p class="eu-lead">There's nothing at this address. It may have moved, or the link may have lost a letter on the way.</p>
    <p><a class="eu-btn" href="/">Back to the components</a></p>
  </div>
</Page>
