---
// Templates: ready-made results, each a tile that opens in the maker. The links are made at
// build time with the same code the maker uses, so they can never drift apart.
import { encodeState } from '@eurth/style';
import Line from '@eurth/style/components/Line.astro';
import Page from '@eurth/style/components/Page.astro';
import PageHead from '@eurth/style/components/PageHead.astro';
import { lineArrowRight } from '@eurth/style/line';
import { site } from '../../eurth.config.mjs';
import { compact, describe, plateSvg, templates } from '../tool/model';
---

<Page
  site={site}
  title="Motto plate templates"
  description="Three ready-made motto plates to start from: a calm republic, an old mountain kingdom and a federation that hasn't decided. Open one and make it yours."
  crumbs={[{ name: 'Templates', path: '/templates/' }]}
>
  <PageHead site={site} kicker="Templates" title="Motto plate templates">
    <Fragment slot="lead">Somewhere to start. Open one in the <a href="/">maker</a> and change what you like; the <a href="/guide/">guide</a> says what makes a motto last.</Fragment>
  </PageHead>
  <ul class="eu-gallery">
    {
      templates.map((t) => (
        <li>
          <a class="eu-tile" href={`/?d=${encodeState(compact(t.plate))}`}>
            <div class="eu-tile-art">
              <img src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(plateSvg(t.plate))}`} alt={describe(t.plate)} width="1200" height="630" loading="lazy" />
            </div>
            <div class="eu-tile-words">
              <h2>{t.name}</h2>
              <p>{t.note}</p>
              <span class="eu-tile-go">Open in the maker <Line icon={lineArrowRight} /></span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Page>
