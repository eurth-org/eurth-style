---
// The header, as on eurth.org: a blue bar with white pills (the tool's own pages, the Tools
// menu, the Deluminator), and under it the yurt, the tool's name, "by Eurth" and the tagline,
// linking to the tool's start. A tool's own actions (Random, Simple/Advanced) belong in the
// tool's toolbar, not here. Join Eurth is in the footer.
//
// The Tools menu lists only tools whose launch date has passed when the site is built.
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';
import yurt from '../assets/eurth-yurt-circle.svg?raw';
import { launchedTools, ref, type Site } from '../build.js';
import { lineChevronDown, lineCompass, lineEdit, lineGrid3, lineImage, lineList, type LineIcon } from '../line.js';
import Deluminator from './Deluminator.svelte';
import Fa from './Fa.astro';
import Line from './Line.astro';

interface Props {
  site: Site & { host: string };
  /** The page being shown: Astro.url.pathname. */
  path: string;
}
const { site, path } = Astro.props;
const launched = launchedTools();
const tools = launched.filter((tool) => tool.kind === 'tool');
const hub = launched.find((tool) => tool.kind === 'hub');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// The pages every tool has come with an icon; a page of the tool's own brings one (pages[].icon).
const usual: Record<string, LineIcon> = { '/': lineEdit, '/guide/': lineCompass, '/glossary/': lineList, '/templates/': lineGrid3, '/examples/': lineImage };
const pages = site.pages.map((page) => ({ ...page, icon: (page.icon ?? usual[page.href]) as IconDefinition | LineIcon | undefined }));
const everyIcon = pages.every((page) => page.icon);
---

<header class="eu-header">
  <div class="eu-topbar">
    <div class="eu-bar">
      {
        pages.length > 1 && (
          <nav class:list={['eu-nav', everyIcon && 'eu-nav--icons']} aria-label={`${site.name} pages`}>
            {pages.map((page) => (
              <a class="eu-barlink" href={page.href} aria-current={isCurrent(page.href) ? 'page' : undefined}>
                {page.icon && ('body' in page.icon ? <Line icon={page.icon} /> : <Fa icon={page.icon} />)}
                <span class="eu-nav-label">{page.label}</span>
              </a>
            ))}
          </nav>
        )
      }
      <div class="eu-header-actions">
        <details class="eu-menu">
          <summary class="eu-barlink">Tools <Line icon={lineChevronDown} class="eu-chevron" /></summary>
          <ul class="eu-menu-list">
            {
              tools.map((tool) => (
                <li>
                  <a href={tool.id === site.id ? '/' : ref(tool.url, site.host)} aria-current={tool.id === site.id ? 'true' : undefined} data-same-tab>
                    {tool.name}
                    <span>{tool.pitch}</span>
                  </a>
                </li>
              ))
            }
            {
              hub && (
                <li>
                  <a href={hub.id === site.id ? '/' : ref(hub.url, site.host)} data-same-tab>
                    All tools
                    <span>{hub.pitch}</span>
                  </a>
                </li>
              )
            }
          </ul>
        </details>
        <span class="eu-deluminator-slot"><Deluminator client:only="svelte" /></span>
      </div>
    </div>
  </div>

  <div class="eu-masthead">
    <div class="eu-bar">
      <a class="eu-brand" href="/" title={`${site.name}: start afresh`}>
        <span class="eu-yurt" data-seasonal aria-hidden="true" set:html={yurt} />
        <span class="eu-brand-name">{site.name}</span>
        <span class="eu-brand-by">by Eurth</span>
      </a>
      <span class="eu-tagline">{site.tagline}</span>
    </div>
  </div>
</header>
